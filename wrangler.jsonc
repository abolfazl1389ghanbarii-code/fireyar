{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"fireeyar",
  "main":"src/index.js",
  "compatibility_date":"2026-09-08",
  "assets":{"directory":"./public","binding":"ASSETS","not_found_handling":"404-page"},
  "d1_databases":[{"binding":"DB","database_name":"fireeyar-db","database_id":"REPLACE_WITH_D1_DATABASE_ID"}],
  "kv_namespaces":[{"binding":"SESSIONS","id":"REPLACE_WITH_KV_NAMESPACE_ID"}]
}
